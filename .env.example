# Copy this file to .env and replace placeholders with your real keys.

# RAG answer generation can use: groq, openai, anthropic, google, or openai-compatible.
LLM_PROVIDER=groq
LLM_API_KEY=""
# Optional: model used by LangChain for RAG answers and chat summaries.
RAG_LLM_MODEL=llama-3.1-8b-instant
# Required only for openai-compatible gateways such as OpenRouter or Together.
# LLM_BASE_URL=https://openrouter.ai/api/v1

# Optional: Groq is still used by the image OCR fallback.
GROQ_API_KEY=""
# Optional: set path to Tesseract if installed in a custom location.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Admin credentials for the first user. These are used to bootstrap the admin account if no users exist.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
